# Application Environment Configuration (Example)
# DO NOT COMMIT REAL SECRETS, CREDENTIALS, OR API KEYS TO GIT.

# Preview / Development Port
PORT=8443

# API Base URL (if proxying to an external FastAPI backend)
VITE_API_BASE=http://localhost:8000/api

# Session Secret Key (placeholder for standalone server deployment)
SESSION_SECRET=replace_with_a_secure_random_64_character_hex_secret

# Sensor Key Seed (optional reproducible seed for cryptographic tests)
SENSOR_KEY_SEED=placeholder_test_seed
